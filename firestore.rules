rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Documento único da festa - permite acesso anônimo com validações
    match /festa/vicente {
      // Qualquer pessoa pode ler (necessário para a lista funcionar)
      allow read;

      // Escrita: somente se a estrutura básica está correta
      allow write: if request.data.keys().hasAll(['adults', 'children', 'categories'])
        && request.data.adults is list
        && request.data.children is list
        && request.data.categories is list
        && request.data.adults.size() <= 200  // limite razoável
        && request.data.children.size() <= 100;
    }

    // Negar acesso a qualquer outro documento
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
